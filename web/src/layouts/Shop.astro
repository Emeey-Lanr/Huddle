---
// Fonts are served from this site. Each file is only downloaded when a page uses
// that font and needs its characters, so a store loads just its own.
import "@fontsource/anton/400.css";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/800.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/800.css";
import "@fontsource/lora/400.css";
import "@fontsource/lora/500.css";
import "@fontsource/lora/700.css";
import "../styles/shop.css";
import { inkOnWhite, onColor } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  plain?: boolean; // bag, checkout, orders: white, calm, nothing between shopper and paying
  refresh?: string;
}

const { store, bagCount } = Astro.locals;
const { title, description = store.store_description, home = false, plain = false, refresh } = Astro.props;
const { theme } = store;

// perEm is roughly how wide a letter is, so a name can fill the screen's width.
const sans = 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
const fonts = {
  anton: { display: `Anton, Impact, ${sans}`, body: `Archivo, ${sans}`, weight: 400, upper: true, perEm: 0.46 },
  system: { display: sans, body: sans, weight: 800, upper: false, perEm: 0.58 },
  inter: { display: `Inter, ${sans}`, body: `Inter, ${sans}`, weight: 800, upper: false, perEm: 0.6 },
  poppins: { display: `Poppins, ${sans}`, body: `Poppins, ${sans}`, weight: 800, upper: false, perEm: 0.62 },
  lora: { display: "Lora, Georgia, serif", body: "Lora, Georgia, serif", weight: 700, upper: false, perEm: 0.55 },
};
const font = fonts[theme.font] ?? fonts.anton;

// k is the name's size in vw, without units, so CSS can divide by it to shrink
// the name into the bar. On wide screens it's capped to stay on the screen.
const length = store.store_name.length;
const k = Math.min(52, Math.max(7, 92 / (length * font.perEm)));
const wideK = Math.min(k, 30);
const animatedName = home && length <= 26;

// Theme values reach this page only after the API's strict checks (#rrggbb).
const tokens = `:root{--ground:${theme.primary_color};--on:${onColor(theme.primary_color)};--flash:${theme.accent_color};--on-flash:${onColor(theme.accent_color)};--ink:${inkOnWhite(theme.primary_color)};--font:${font.body};--display:${font.display};--display-weight:${font.weight};--display-case:${font.upper ? "uppercase" : "none"};--k:${k.toFixed(2)};--wide-k:${wideK.toFixed(2)}}`;
---

<!doctype html>
<html lang="en" class:list={[plain ? "plain" : "flood", { "has-wordmark": animatedName }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · ${store.store_name}` : store.store_name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme.primary_color} />
    {refresh && <meta http-equiv="refresh" content={refresh} />}
    <style set:html={tokens}></style>
  </head>
  <body>
    <header class="bar">
      <a class="bar-name" href="/">
        {theme.logo_url ? <img src={theme.logo_url} alt={store.store_name} height="28" /> : store.store_name}
      </a>
      <a class="bag" href="/bag">Bag <span class="bag-count" data-bag-count>{bagCount}</span></a>
    </header>
    {
      animatedName && (
        <a class="wordmark" href="/" aria-hidden="true" tabindex="-1">
          <span>{store.store_name}</span>
        </a>
      )
    }

    <main><slot /></main>

    {
      !plain && (
        <footer class="foot">
          <p class:list={["foot-name", { "foot-name--long": length > 26 }]} aria-hidden="true">{store.store_name}</p>
        </footer>
      )
    }
    <p class="toast" role="status" data-toast></p>

    <script>
      import "../scripts/bag.ts";
    </script>
  </body>
</html>
