{
  "openapi":"3.0.3",
  "info":{
    "title":"Huddle API",
    "version":"1.0.0"
  },
  "tags":[
    {"name":"Admin Auth",
    "description":"Admin Authetication endpoints"
  },
   {"name":"Create Store",
    "description":"Store Creation endpoints"
  }
  ],

  "components":{
    "securitySchemes":{
      "BearerAuth":{
        "type":"http",
        "scheme":"bearer",
        "bearerFormat":"JWT"
      }
    }
  },

  "paths":{
    "/admin/signup": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Create an admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Admin Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": { "type": "string" },
                    "password": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/admin/signin": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Create an admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": { "type": "string" },
                    "password": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/store/create": {
      "post": {
        "tags": ["Create Store"],
        "summary": "Create a store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["store", "description"],
                "properties": {
                  "store_name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": { "type": "string" },
                    "password": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}