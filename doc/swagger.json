{
  "openapi": "3.0.3",
  "info": {
    "title": "Huddle API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "Admin Auth", "description": "Admin Authetication endpoints" },
    { "name": "Create Store", "description": "Store Creation endpoints" },
    { "name": "Products", "description": "Produtcs Endpoint" }
  ],

  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },

  "paths": {
    "/admin/signup": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Create an admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Admin Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": { "type": "string" },
                    "password": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/admin/signin": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Create an admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": { "type": "string" },
                    "password": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/store/create": {
      "post": {
        "tags": ["Create Store"],
        "summary": "Create a store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["store", "description"],
                "properties": {
                  "store_name": { "type": "string" },
                  "store_description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "api_key": "c4511c01278ae91afaa892cbbcf3b56b369a255ddf8899a9ce5e2634f1665fbeb73f",
                      "created_at": "2025-12-22T12:36:39.9006295Z",
                      "store_id": "str-a171d3b4-7927-43a7-bf77-3c28c979c9ee",
                      "store_description": "",
                      "store_name": "Paint"
                    },
                    "message": "Store Created Succesfully",
                    "success": true
                  }
                }
              }
            }
          }
        }
      }
    },

    "/products/create": {
      "post": {
        "tags": ["Products"],
        "summary": "Create a store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["store", "description"],
                "properties": {
                  "name": "Dream",
                  "description": "An art sofa crafted and designed by Emeey",
                  "price": 50000,
                  "currency": "USD",
                  "stock_quantity": 2
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "id": "2eb6c949-0f20-4213-a271-21ae9b3dcd42"
                    },
                    "message": "Product Added Succesfully",
                    "success": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
