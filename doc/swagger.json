{
  "openapi": "3.0.3",
  "info": {
    "title": "Huddle API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "Admin Auth", "description": "Admin Authetication endpoints" },
    { "name": "Create Store", "description": "Store Creation endpoints" },
    { "name": "Products", "description": "Produtcs Endpoint" }
  ],

  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },

    "parameters":{
      "XStoreId":{
        "name":"X-Store_Id",
        "in":"header",
        "required":true,
        "description":"Store identifier",
        "schema":{
          "type":"string",
          "format":"uuid"
        }
      }
    }
  },

  "paths": {
    "/admin/signup": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Create an admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Admin Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": { "type": "string" },
                    "password": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/admin/signin": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Create an admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."
                    },
                    "message": "Login Succesfull",
                    "success": true
                  }
                }
              }
            }
          }
        }
      }
    },

    "/store/create": {
      "post": {
        "tags": ["Create Store"],
        "summary": "Create a store",
        "security":[
           {"BearerAuth":[]}
        ],
        "parameters":[ 
         {"$ref":"#/components/parameters/XStoreId"}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["store", "description"],
                "properties": {
                  "store_name": { "type": "string" },
                  "store_description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schemas": {
                  "type":"object",
                  "properties":{
                  "data":{
                    "type":"object",
                    "properties":{
                      "apikey":{"type":"string"}
                    }
                  },
                  "message":{"type":"string"}
                  }
                }
              }
            }
          }
        }
      }
    },

    "/products/create": {
      "post": {
        "tags": ["Products"],
        "summary": "Create a store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object", 
                "required": ["store", "description"],
                "properties": {
                  "name": "Dream",
                  "description": "An art sofa crafted and designed by Emeey",
                  "price": 50000,
                  "currency": "USD",
                  "stock_quantity": 2
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "id": "2eb6c949-0f20-4213-a271-21ae9b3dcd42"
                    },
                    "message": "Product Added Succesfully",
                    "success": true
                  }
                }
              }
            }
          }
        }
      }
    },

    "/products/images": {
      "post": {
        "tags": ["Products"],
        "summary": "Add Image/s to product(min of 1 and max of 5) and each should be equal or lesser than 5mb",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type":"string",
                    "format":"binary"
                  }
                }
              },
              "encoding":{
               "image":{
                "contentType":"image/jpeg"
               }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Login Succesfull",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "id": "2eb6c949-0f20-4213-a271-21ae9b3dcd42"
                    },
                    "message": "Product Added Succesfully",
                    "success": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
